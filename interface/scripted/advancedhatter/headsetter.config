{
  "gui": {
    "background": {
      "type": "background",
      "fileHeader": "/interface/scripted/advancedhatter/body/header.png",
      "fileBody": "/interface/scripted/advancedhatter/body/body.png",
      "zlevel": -1
    },

    "windowLogo": {
      "type": "image",
      "position": [1, 81],
      "file": "/quickbar/headsetter.png",
      "zlevel": 0
    },

    "windowTitle": {
      "type": "label",
      "position": [24, 85],
      "hAnchor": "left",
      "value": "Head setter - Set your animated head!",
      "fontSize": 8,
      "zlevel": -1
    },

    "fieldBackground": {
      "type": "image",
      "position": [3, 3],
      "file": "/chroma/images/pixel.png?replace;FFFFFF=111111?scale=194;74",
      "zlevel": 0
    },

    "lblSetLayer": {
      "type": "label",
      "position": [5, 51],
      "value": "Animation layer"
    },
    
    "btnSetEmotingLayer": {
      "type": "button",
      "callback": "changeLayer",
      "base": "/interface/scripted/advancedhatter/images/pixel.png?replace;FFFFFF=2a2a2a?scale=47;8?border=2;4c4c4c?border=1;000",
      "hover": "/interface/scripted/advancedhatter/images/pixel.png?replace;FFFFFF=4c4c4c?scale=47;8?border=2;888?border=1;000",
      "pressedOffset": [ 0, 0 ],
      "position": [ 71, 48 ]
    },

    "lblHeadPath": {
      "type": "label",
      "position": [5, 25],
      "value": "/animatedhats/                               .json"
    },

    "tbxSetHead": {
      "type": "textbox",
      "position": [74, 25],
      "maxWidth": 60,
      "hint": "name",
      "callback": "null",
      "enterKey": "setHead"
    },

    "btnOpenHatList": {
      "type": "button",
      "callback": "changeHat",
      "visible": false,
      "base": "/interface/scripted/advancedhatter/buttons/hatselect.png:base",
      "hover": "/interface/scripted/advancedhatter/buttons/hatselect.png:hover",
      "pressed": "/interface/scripted/advancedhatter/buttons/hatselect.png:selectedhover",
      "pressedOffset": [0, 0],
      "position": [135, 23],
      "zlevel": 2
    },

    "btnSave": {
      "type": "button",
      "caption": "Set head",
      "callback": "setHead",
      "base": "/interface/scripted/advancedhatter/images/pixel.png?replace;FFFFFF=2a2a2a?scale=47;8?border=2;4c4c4c?border=1;000",
      "hover": "/interface/scripted/advancedhatter/images/pixel.png?replace;FFFFFF=4c4c4c?scale=47;8?border=2;888?border=1;000",
      "position": [4, 4]
    },

    "btnClear": {
      "type": "button",
      "caption": "Clear head",
      "callback": "clearHead",
      "base": "/interface/scripted/advancedhatter/images/pixel.png?replace;FFFFFF=772a2a?scale=47;8?border=2;aa3b3b?border=1;000",
      "hover": "/interface/scripted/advancedhatter/images/pixel.png?replace;FFFFFF=aa3b3b?scale=47;8?border=2;cc6c6c?border=1;000",
      "position": [143, 4]
    },

    "close" : {
      "type" : "button",
      "base" : "/interface/x.png",
      "hover" : "/interface/xhover.png",
      "pressed" : "/interface/xpress.png",
      "pressedOffset" : [0, 0],
      "position" : [187, 83]
    }
  },
  "scriptWidgetCallbacks": ["setHead", "clearHead", "changeLayer", "changeHat"],
  "scripts" : [ "/interface/scripted/advancedhatter/headsetter.lua" ]
}